# ──────────────────────────────────────────────────────────────
# Planify · plantilla de variables de entorno
# Copiar a `.env` y rellenar los valores.
# ──────────────────────────────────────────────────────────────

# Base de datos usada por los comandos del host (npm run dev, prisma migrate dev,
# db:reset-password). Desarrollo: contenedor de docker-compose.dev.yml (5433).
DATABASE_URL="postgresql://planify:planify@localhost:5433/planify"

# Solo para el contenedor `db` del docker-compose de producción (docs/10).
POSTGRES_PASSWORD=""

# URL que usan los contenedores `migrate` y `app` dentro de la red de Compose.
# `localhost` no vale ahí (sería el propio contenedor): el host es `db`.
# Misma contraseña que POSTGRES_PASSWORD, percent-encoded si lleva caracteres
# reservados de URL (`/` → `%2F`, `@` → `%40`, `#` → `%23`, `:` → `%3A`).
DATABASE_URL_DOCKER="postgresql://planify:clave@db:5432/planify"

# better-auth — generar el secreto con:
#   openssl rand -base64 48
#   (Windows) $b=New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
BETTER_AUTH_SECRET=""
# URL pública de la app (en producción, la del dominio o IP del servidor)
BETTER_AUTH_URL="http://localhost:3000"

# Subidas de archivos
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="20"

# Registro de usuarios (poner en "false" para cerrarlo)
REGISTRATION_OPEN="true"

# Zona horaria
TZ="Europe/Madrid"
