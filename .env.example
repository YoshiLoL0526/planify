# ──────────────────────────────────────────────────────────────
# Planify · plantilla de variables de entorno
# Copiar a `.env` y rellenar los valores.
# ──────────────────────────────────────────────────────────────

# Base de datos. Desarrollo: contenedor de docker-compose.dev.yml (puerto 5433).
# Producción: postgresql://planify:<clave>@db:5432/planify
DATABASE_URL="postgresql://planify:planify@localhost:5433/planify"

# better-auth — generar el secreto con:
#   openssl rand -base64 48
#   (Windows) $b=New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
BETTER_AUTH_SECRET=""
# URL pública de la app (en producción, la del dominio o IP del servidor)
BETTER_AUTH_URL="http://localhost:3000"

# Subidas de archivos
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="20"

# Registro de usuarios (poner en "false" para cerrarlo)
REGISTRATION_OPEN="true"

# Zona horaria
TZ="Europe/Madrid"
